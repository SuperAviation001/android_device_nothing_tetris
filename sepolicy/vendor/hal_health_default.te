# Define nt-chg type
type sysfs_ntchg, fs_type, sysfs_type;

# Allow hal_health_default access to nt-chg
allow hal_health_default sysfs_ntchg:file rw_file_perms;

# Allow hal_health_default access to sysfs
allow hal_health_default sysfs:file rw_file_perms;
allow hal_health_default sysfs_power_supply:dir search;
allow hal_health_default sysfs:file { getattr open read };
allow hal_health_default sysfs_power_supply:file { getattr open read };
