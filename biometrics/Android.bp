cc_binary {
    name: "android.hardware.biometrics.fingerprint@2.3-service.tetris",
    defaults: ["hidl_defaults"],
    init_rc: ["android.hardware.biometrics.fingerprint@2.3-service.tetris.rc"],
    vintf_fragments: ["android.hardware.biometrics.fingerprint@2.3-service.tetris.xml"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "BiometricsFingerprint.cpp",
        "service.cpp",
    ],

    shared_libs: [
        "libcutils",
        "liblog",
        "libhidlbase",
        "libhardware",
        "libutils",
        "android.hardware.biometrics.fingerprint@2.3",
        "android.hardware.biometrics.fingerprint@2.2",
        "android.hardware.biometrics.fingerprint@2.1",
    ],

    header_libs: ["goodixfingerprint_headers"],
}

cc_library_headers {
    name: "goodixfingerprint_headers",
    export_include_dirs: ["include"],
    vendor: true,
    header_libs: ["libhardware_headers"],
    export_header_lib_headers: ["libhardware_headers"],
}
